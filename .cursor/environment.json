{
  "name": "RevenueTrace AI",
  "install": "bash scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "python3 -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000"
    },
    {
      "name": "web",
      "command": "npm --prefix frontend run dev"
    }
  ],
  "ports": [
    {
      "name": "RevenueTrace API",
      "port": 8000
    },
    {
      "name": "RevenueTrace Web",
      "port": 5173
    }
  ]
}
